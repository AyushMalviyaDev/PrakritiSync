# Django Production Environment Variables Example
DJANGO_SECRET_KEY=change-this-to-a-very-long-random-secret-key-in-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-app.onrender.com,your-domain.com

# CORS Allowed Origins (Comma separated frontend URLs)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

# Database Options:
# Option 1: Full Database URL (Postgres or MySQL)
# DATABASE_URL=mysql://root:rootpassword@db:3306/ayursutra
# DATABASE_URL=postgresql://user:password@render-host.com/ayursutra

# Option 2: Individual variables
DB_ENGINE=django.db.backends.mysql
DB_NAME=ayursutra
DB_USER=root
DB_PASSWORD=root
DB_HOST=localhost
DB_PORT=3306

# Option 3: Quick testing with SQLite
# USE_SQLITE=True
